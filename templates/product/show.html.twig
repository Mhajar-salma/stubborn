{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} | Stubborn{% endblock %}

{% block body %}
<style>
.detail {
    max-width: 1100px;
    margin: 55px auto;
    padding: 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    color: #ffffff;
}
.detail img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    background: #f2f2f2;
}
.detail h1 { font-size: 42px; text-transform: uppercase; }
.price { color: #e32636; font-size: 26px; font-weight: 800; }
select, button { padding: 14px; font-size: 16px; }
button {
    background: #e32636;
    color: white;
    border: 0;
    font-weight: 800;
    cursor: pointer;
    width: 100%;
    margin-top: 18px;
}
@media(max-width:700px) {
    .detail { grid-template-columns: 1fr; }
}
</style>

<main class="detail">
    <div>
        <img src="{{ product.image ?: '/images/placeholder.jpg' }}" alt="{{ product.name }}">
    </div>

    <div>
        <p>STUBBORN — DON'T COMPROMISE ON YOUR LOOK</p>
        <h1>{{ product.name }}</h1>
        <p class="price">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>
        <p>{{ product.description }}</p>

        <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post">
            <label for="size">Choisis ta taille</label>
            <select id="size" name="size" required>
                {% for stock in product.sizes %}
                    <option value="{{ stock.size }}">
                        {{ stock.size }} — {{ stock.quantity }} disponible(s)
                    </option>
                {% endfor %}
            </select>

            <label for="quantity">Quantité</label>
            <input id="quantity" type="number" name="quantity" value="1" min="1" max="2" required>

            <button type="submit">AJOUTER AU PANIER</button>
        </form>
    </div>
</main>
{% endblock %}
