<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Stubborn — Don't compromise on your look{% endblock %}</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #090909;
            color: #f5f5f5;
            font-family: Arial, Helvetica, sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .site-header {
            min-height: 76px;
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            flex-wrap: wrap;
            border-bottom: 1px solid #292929;
        }

        .brand {
            font-size: 27px;
            font-weight: 900;
            font-style: italic;
        }

        .brand span {
            color: #f20d2d;
        }

        .site-nav {
            display: flex;
            gap: 22px;
            flex-wrap: wrap;
        }

        .site-nav a {
            font-size: 12px;
            font-weight: bold;
        }

        .site-nav a:hover {
            color: #f20d2d;
        }

        .site-footer {
            padding: 30px 6%;
            border-top: 1px solid #292929;
            color: #aaa;
            font-size: 12px;
        }

        .flash-container {
            max-width: 1000px;
            margin: 20px auto;
            padding: 0 20px;
        }

        .flash-message {
            padding: 16px;
            margin-bottom: 12px;
            border-radius: 5px;
            font-weight: bold;
        }

        .flash-error {
            background: #4a1010;
            color: #ffaaaa;
            border: 1px solid #e32636;
        }

        .flash-success {
            background: #103a20;
            color: #a8f0bd;
            border: 1px solid #2baf58;
        }

        .flash-warning {
            background: #493510;
            color: #ffe0a0;
            border: 1px solid #d99a24;
        }

        @media (max-width: 600px) {
            .site-header {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>
<header class="site-header">
    <a class="brand" href="{{ path('app_home') }}">STUBBORN<span>.</span></a>

    <nav class="site-nav">
        <a href="{{ path('app_home') }}">ACCUEIL</a>
        <a href="{{ path('app_products') }}">COLLECTION</a>
        <a href="{{ path('app_cart') }}">PANIER</a>
        <a href="{{ path('app_account') }}">MON COMPTE</a>
    </nav>
</header>

<div class="flash-container">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-message flash-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
</div>

{% block body %}{% endblock %}

<footer class="site-footer">
    STUBBORN. — Don't compromise on your look.
</footer>
</body>
</html>
EOF